{
  "name": "@greenlight/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Greenlight relay server: stores agent session state and pending decisions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
